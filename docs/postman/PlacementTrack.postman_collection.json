            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/applications/{{applicationId}}/notes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "applications",
            "{{applicationId}}",
            "notes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"notes\": \"Revise DBMS normalisation and OS scheduling.\"\n}"
