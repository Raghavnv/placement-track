    {
      "name": "Admin / Stats",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/admin/stats",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
