# Copy to server/.env and fill in real values. NEVER commit server/.env.
# 5000 is taken by macOS AirPlay Receiver, so we use 5050. Render sets PORT itself.
PORT=5050
NODE_ENV=development

# Local:  mongodb://127.0.0.1:27017/placement-track
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/placement-track
MONGO_URI=mongodb://127.0.0.1:27017/placement-track

# Generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Allowed CORS origin (the Vite dev server)
CLIENT_URL=http://localhost:5173

# Used once by the admin seed script to create the placement officer account
ADMIN_SEED_EMAIL=officer@college.edu
ADMIN_SEED_PASSWORD=change-me
