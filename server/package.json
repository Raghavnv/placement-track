{
  "name": "placement-track-server",
  "version": "0.1.0",
  "private": true,
  "description": "PlacementTrack REST API (Express + MongoDB)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "seed": "node src/utils/seed.js",
    "seed:admin": "node src/utils/seedAdmin.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "fflate": "^0.8.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "pdfkit": "^0.17.2",
    "unpdf": "^1.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/src/tests/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/src/tests/setup/env.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/tests/setup/db.js"
    ],
    "globalSetup": "<rootDir>/src/tests/setup/globalSetup.js",
    "globalTeardown": "<rootDir>/src/tests/setup/globalTeardown.js",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/utils/seed*.js",
      "!src/tests/**"
    ]
  }
}
