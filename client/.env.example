# Copy to client/.env and adjust. NEVER commit client/.env.
# Only variables prefixed with VITE_ are exposed to the browser - never put secrets here.

# Leave as /api in development (Vite proxies it to the server, see vite.config.js).
# In production set it to the deployed API URL, e.g. https://api.example.com/api
VITE_API_BASE_URL=/api

# Days before a drive deadline when the student reminder banner appears
VITE_REMINDER_DAYS=3
